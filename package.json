{
  "name": "quant-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "QUANT RUSH — Market Maker: a 3D arcade game about market making, spreads, inventory risk and hedging.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lab": "vite-node scripts/quantlab.ts",
    "balance": "vite-node scripts/balance.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "postprocessing": "^6.39.5",
    "react": "19.2",
    "react-dom": "19.2",
    "three": "^0.180.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
